# Paste your API keys after the = signs (no quotes, no spaces).
# You only need the key(s) for the engine(s) you use.

# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude key: create one in the Claude Console (platform.claude.com) under API Keys. Needs API credits; separate from a Claude.ai subscription.
ANTHROPIC_API_KEY=

# Optional: change models without editing code.
# GEMINI_MODEL=gemini-3.1-pro-preview
# CLAUDE_MODEL=claude-opus-5-5
